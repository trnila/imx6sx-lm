SDP: write -f ../../out/imx6sx-lm/linux/arch/arm/boot/dts/nxp/imx/imx6sx-lm.dtb -addr 0x83000000
SDP: jump -f ../../out/imx6sx-lm/u-boot/u-boot-dtb.imx -ivt
